rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // PPDB Registrations: Anyone can create a registration, read registrations, and update status
    match /ppdb_registrations/{registrationId} {
      allow read, create, update, delete: if true;
    }
    
    // School Announcements: Public read, authorized updates
    match /school_announcements/{announcementId} {
      allow read, write: if true;
    }

    // Contact Inquiries: Anyone can send messages, public/admin read
    match /contact_inquiries/{inquiryId} {
      allow read, create, update, delete: if true;
    }
    
    // Default rule for school settings & stats
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
